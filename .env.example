DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional: enables model-based note extraction. Without it, Keepsake uses local heuristics.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Optional: posts delivered reminders to this URL as JSON instead of the server log.
# KEEPSAKE_WEBHOOK_URL=https://ntfy.sh/your-topic
# Optional: enables Google contacts sync. Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials, enable the People API,
# and add <your-origin>/api/auth/google/callback as an authorized redirect URI.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=https://your-domain/api/auth/google/callback
# Required in production when Google sync is enabled. Generate once with:
# openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=...
# Free browser push notifications. Generate with `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=https://your-domain
